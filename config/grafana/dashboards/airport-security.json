{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana",    "id": "grafana",    "name": "Grafana",    "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel",      "id": "stat",       "name": "Stat",       "version": "" },
    { "type": "panel",      "id": "timeseries", "name": "Time series","version": "" },
    { "type": "panel",      "id": "table",      "name": "Table",      "version": "" },
    { "type": "panel",      "id": "row",        "name": "Row",        "version": "" }
  ],
  "description": "Live and historical airport security queue monitoring",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "refresh": "1m",
  "schemaVersion": 38,
  "tags": ["airports", "prometheus", "fetchtime"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(airport_queue_minutes, airport)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "airport",
        "label": "Airport",
        "options": [],
        "query": {
          "query": "label_values(airport_queue_minutes, airport)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Airport Security Queues",
  "uid": "airport-security-queues",
  "version": 1,
  "panels": [

    {
      "id": 1,
      "title": "Current Queue Wait Time",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "airport_queue_minutes{airport=~\"$airport\"}",
          "legendFormat": "{{airport}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red",    "value": 20 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },

    {
      "id": 2,
      "title": "Queue Wait Times",
      "description": "Security queue wait time per airport over time",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "airport_queue_minutes{airport=~\"$airport\"}",
          "legendFormat": "{{airport}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "mean", "max"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red",    "value": 20 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 10,
      "title": "Pull Health",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 }
    },

    {
      "id": 3,
      "title": "Minutes Since Last Successful Pull",
      "description": "How long ago each airport was last successfully fetched. Alert if > 10 min.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "(time() - airport_last_pull_timestamp_seconds{airport=~\"$airport\"}) / 60",
          "legendFormat": "{{airport}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 1,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 6 },
              { "color": "red",    "value": 10 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 4,
      "title": "Pull Success Rate (10 min window)",
      "description": "Ratio of successful pulls to total pull attempts per airport",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(airport_pull_total{status=\"success\", airport=~\"$airport\"}[10m]) / rate(airport_pull_total{airport=~\"$airport\"}[10m])",
          "legendFormat": "{{airport}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "asc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green",  "value": 0.99 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 11,
      "title": "Performance",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }
    },

    {
      "id": 5,
      "title": "Fetch Duration — P50 / P95 / P99",
      "description": "Time taken to fetch and store each airport's queue data",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.50, rate(airport_pull_duration_seconds_bucket{airport=~\"$airport\"}[10m]))",
          "legendFormat": "p50 {{airport}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, rate(airport_pull_duration_seconds_bucket{airport=~\"$airport\"}[10m]))",
          "legendFormat": "p95 {{airport}}",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.99, rate(airport_pull_duration_seconds_bucket{airport=~\"$airport\"}[10m]))",
          "legendFormat": "p99 {{airport}}",
          "refId": "C"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 0 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red",    "value": 15 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 6,
      "title": "Failed Pulls in Last Hour",
      "description": "Number of failed airport data fetches per hour. Any value > 0 indicates a broken pull.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "increase(airport_pull_total{status=\"failure\", airport=~\"$airport\"}[1h])",
          "legendFormat": "{{airport}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "drawStyle": "bars",
            "barAlignment": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 12,
      "title": "Airport Summary",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 }
    },

    {
      "id": 7,
      "title": "Airport Status Table",
      "description": "Snapshot of current queue, time since last pull, and total pull counts",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "airport_queue_minutes",
          "legendFormat": "{{airport}}",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "(time() - airport_last_pull_timestamp_seconds) / 60",
          "legendFormat": "{{airport}}",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "increase(airport_pull_total{status=\"success\"}[1h])",
          "legendFormat": "{{airport}}",
          "instant": true,
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "increase(airport_pull_total{status=\"failure\"}[1h])",
          "legendFormat": "{{airport}}",
          "instant": true,
          "refId": "D"
        }
      ],
      "options": {
        "sortBy": [{ "displayName": "Queue (min)", "desc": true }],
        "footer": { "show": false }
      },
      "transformations": [
        { "id": "labelsToFields", "options": { "valueLabel": "airport" } },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "airport":  "Airport",
              "Value #A": "Queue (min)",
              "Value #B": "Last Pull (min ago)",
              "Value #C": "Successful Pulls (1h)",
              "Value #D": "Failed Pulls (1h)"
            },
            "excludeByName": { "Time": true }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "decimals": 1 },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Queue (min)" },
            "properties": [
              { "id": "unit", "value": "m" },
              { "id": "decimals", "value": 0 },
              { "id": "thresholds", "value": {
                "mode": "absolute",
                "steps": [
                  { "color": "green",  "value": null },
                  { "color": "yellow", "value": 10 },
                  { "color": "red",    "value": 20 }
                ]
              }},
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Last Pull (min ago)" },
            "properties": [
              { "id": "unit", "value": "m" },
              { "id": "decimals", "value": 1 },
              { "id": "thresholds", "value": {
                "mode": "absolute",
                "steps": [
                  { "color": "green",  "value": null },
                  { "color": "yellow", "value": 6 },
                  { "color": "red",    "value": 10 }
                ]
              }},
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Failed Pulls (1h)" },
            "properties": [
              { "id": "decimals", "value": 0 },
              { "id": "thresholds", "value": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "red",   "value": 1 }
                ]
              }},
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Successful Pulls (1h)" },
            "properties": [
              { "id": "decimals", "value": 0 }
            ]
          }
        ]
      }
    }

  ]
}
